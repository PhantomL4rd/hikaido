{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "hikaido",
  "main": ".svelte-kit/cloudflare/_worker.js",
  "compatibility_date": "2026-11-11",
  "compatibility_flags": [
    "nodejs_compat"
  ],
  "assets": {
    "binding": "ASSETS",
    "directory": ".svelte-kit/cloudflare"
  },
  "d1_databases": [
    {
      "binding": "DB",
      "database_name": "hikaido",
      "database_id": "e62629af-b16b-4849-ad77-a420222c0278",
      "migrations_dir": "drizzle"
    }
  ],
  "vars": {
    "PUBLIC_SENTRY_DSN": "https://bd90508b295420f037a4fdb6a1ccdb32@o4512013937606656.ingest.us.sentry.io/4512412882567168",
    "PUBLIC_TURNSTILE_SITE_KEY": "0x4AAAAAAF8bwQRvvc7yEktK",
    "TURNSTILE_HOSTNAME": "hikaido.pl4rd.com",
    "LOCAL_TEST_MODE": "false"
  },
  "observability": {
    "enabled": false,
    "logs": {
      "enabled": false,
      "invocation_logs": false
    },
    "traces": {
      "enabled": false
    }
  },
  "routes": [
    {
      "pattern": "hikaido.pl4rd.com",
      "custom_domain": true
    }
  ],
  "workers_dev": false
}

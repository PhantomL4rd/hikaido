{
  "files": {
    "includes": [
      "src/**",
      "tests/**",
      "scripts/**",
      "*.json",
      "*.ts",
      "*.yaml",
      "!!worker-configuration.d.ts",
      "!!pnpm-lock.yaml",
      "!!src/lib/server/og/assets.generated.js"
    ]
  },
  "formatter": {
    "enabled": true,
    "indentStyle": "space"
  },
  "linter": {
    "enabled": true,
    "rules": {
      "preset": "recommended"
    }
  },
  "assist": {
    "actions": {
      "source": {
        "organizeImports": "on"
      }
    }
  },
  "html": {
    "experimentalFullSupportEnabled": true,
    "formatter": {
      "enabled": true
    }
  }
}
